        "faq_item_Bw8zJy": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take to receive an order?",
            "answer": "<p>Our products are handcrafted and made-to-order. Typically, it takes<strong>4-5 days to craft</strong>an item, followed by an additional<strong>3-4 days for delivery.</strong>Please allow<strong>7 to 10 days</strong>in total to receive your order.</p>",
            "category_id": "shipping",
            "category_label": "Shipping & Delivery",
            "show_on_home": true
          }
        },
        "faq_item_XbrEfb": {
          "type": "faq_item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order is shipped, you will receive tracking information via<strong>email, SMS, and WhatsApp.</strong>You can use the provided tracking number to monitor the status and estimated delivery date of your order. Link to -&gt;<a href=\"https://banjaaranstudio.ithinklogistics.co.in/\" target=\"_blank\">Order Tracking Page</a></p>",
            "category_id": "shipping",
            "category_label": "Shipping & Delivery",
            "show_on_home": true
          }
        },
        "faq_item_8f7bb4": {
          "type": "faq_item",
          "settings": {
            "question": "Where do you ship from?",
            "answer": "<p>All orders are crafted and dispatched from our production unit in <strong>Faridabad, within the Delhi NCR region</strong>.</p>",
            "category_id": "shipping",
            "category_label": "Shipping & Delivery",
            "show_on_home": false
          }
        },
        "faq_item_yybUAY": {
          "type": "faq_item",
          "settings": {
            "question": "Which courier partners do you use for delivery?",
            "answer": "<p>We partner with <strong>Delhivery, BlueDart, and Ecom Express</strong> depending on your pin code.</p>",
            "category_id": "shipping",
            "category_label": "Shipping & Delivery",
            "show_on_home": false
          }
        },
        "faq_item_MtGgCN": {
          "type": "faq_item",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>You will receive a tracking link via SMS and email once your order is dispatched. You can also check under <strong>My Orders</strong> in your account.</p>",
            "category_id": "shipping",
            "category_label": "Shipping & Delivery",
            "show_on_home": false
          }
        },
        "faq_item_aBxd7N": {
          "type": "faq_item",
          "settings": {
            "question": "How do I start the exchange process and is there a time limit to request an exchange?",
            "answer": "<p>To start an exchange at Banjaaran Studio, submit your request through our<a href=\"https://banjaaran.in/apps/return_prime\" target=\"_blank\">Exchange Request Portal</a>within 7 days of delivery. We cover all shipping costs for exchanges, ensuring a hassle-free process for you.</p>",
            "category_id": "returns",
            "category_label": "Exchanges & Returns",
            "show_on_home": true
          }
        },
        "faq_item_EkNriq": {
          "type": "faq_item",
          "settings": {
            "question": "How do I start a return and what refund do I get?",
            "answer": "<p><strong>WE DO NOT OFFER BANK REFUNDS.</strong>Contact us within<strong>7 days</strong>of delivery at<a>support@banjaaran.in</a>or +91-9999474819 with product photos. We cover shipping costs. You'll receive a<strong>credit coupon</strong>for the item’s full price, with no expiration.</p>",
            "category_id": "returns",
            "category_label": "Exchanges & Returns",
            "show_on_home": true
          }
        },
        "faq_item_Cy6i7N": {
          "type": "faq_item",
          "settings": {
            "question": "What conditions must the item meet for an exchange or return to be eligible?",
            "answer": "<p>The item must be in immaculate, resellable condition with no signs of wear, and must retain all original packaging, tags, accessories, and gifts.</p>",
            "category_id": "returns",
            "category_label": "Exchanges & Returns",
            "show_on_home": true
          }
        },
        "faq_item_TaCNp3": {
          "type": "faq_item",
          "settings": {
            "question": "Where are we based and do you have any physical stores?",
            "answer": "<p>We are based in<strong>Faridabad, Delhi NCR</strong>, where we manage our in-house manufacturing. Currently,<strong>we exclusively sell our products online</strong>and do not operate any physical retail outlets. We<strong>ship PAN India.</strong>Please enjoy browsing our comprehensive online collection, and if you have any queries or need assistance, feel free to reach out.</p>",
            "category_id": "misc",
            "category_label": "Miscellaneous",
            "show_on_home": true
          }
        },
        "faq_item_KYXVBX": {
          "type": "faq_item",
          "settings": {
            "question": "Do you offer product customizations?",
            "answer": "<p>At this time,<strong>we do not offer customizations.</strong>Please explore our existing product range to find items that meet your needs.</p>",
            "category_id": "misc",
            "category_label": "Miscellaneous",
            "show_on_home": true
          }
        },
        "faq_item_ANTUKJ": {
          "type": "faq_item",
          "settings": {
            "question": "When is a token amount required for COD orders?",
            "answer": "<p>A token amount of<strong>INR 500</strong>is required for COD orders if you've previously not accepted a COD order, your address is incomplete, or the delivery is to a distant region. This ensures the dedication of our artisans is respected. You'll receive a payment link via email for secure payment.</p>",
            "category_id": "misc",
            "category_label": "Miscellaneous",
            "show_on_home": true
          }
        },
        "faq_item_qJ3tFr": {
          "type": "faq_item",
          "settings": {
            "question": "What are the shipping costs and delivery timeline for international orders?",
            "answer": "<p><strong>International shipping costs are paid by the customer</strong>and are not included in the free shipping offer. We aim to ship your order within<strong>10-14 days</strong>, but delivery times may vary based on location, distance, and logistics partners.</p>",
            "category_id": "international",
            "category_label": "International Orders",
            "show_on_home": true
          }
        },
        "faq_item_jFEYzn": {
          "type": "faq_item",
          "settings": {
            "question": "How can I place my international order and what are the payment options?",
            "answer": "<p>If you are facing any issues placing an international order, please contact support. For all international orders, payment must be prepaid using<strong>PayPal</strong>or<strong>Razorpay</strong>;<strong>Cash on Delivery (COD) is not available</strong>for these transactions.</p>",
            "category_id": "international",
            "category_label": "International Orders",
            "show_on_home": true
          }
        },
        "faq_item_kgRBtL": {
          "type": "faq_item",
          "settings": {
            "question": "Are there additional fees I should be aware of when ordering internationally?",
            "answer": "<p>Yes, the recipient may be responsible for handling fees and taxes applicable in your country. For orders to the<strong>UK and EU</strong>, Customs and VAT will be charged as per local laws, which are payable by the customer.</p>",
            "category_id": "international",
            "category_label": "International Orders",
            "show_on_home": true
          }
        },
        "faq_item_TLeACg": {
          "type": "faq_item",
          "settings": {
            "question": "How can i contact customer support?",
            "answer": "<p>Our support is available via call, WhatsApp, and email at the provided contact details.</p><p>Call (11am to 6pm):<a href=\"tel:+919999474819\" target=\"_blank\">+91-9999474819</a></p><p>WhatsApp:<a href=\"https://wa.me/919999474819\" target=\"_blank\">+919999474819</a></p><p>Email:<a href=\"mailto:support@banjaaran.in\" target=\"_blank\">support@banjaaran.in</a> / <a href=\"mailto:studio@banjaaran.in\" target=\"_blank\">studio@banjaaran.in</a></p>",
            "category_id": "contact",
            "category_label": "Contact Information",
            "show_on_home": true
          }
        },
        "faq_item_RpNzWx": {
          "type": "faq_item",
          "settings": {
            "question": "How can I contact you for business-related queries, like collaborations, business proposals, or bulk order inquiries?",
            "answer": "<p>For business-related inquiries, please send an email to<a href=\"mailto:karanveer@banjaaran.in\" target=\"_blank\">Karanveer@banjaaran.in</a>and<a href=\"mailto:meera@banjaaran.in\" target=\"_blank\">Meera@banjaaran.in</a>. Be sure to clearly mention the<strong>purpose of your inquiry in the subject line</strong>to ensure a timely response. We look forward to exploring potential opportunities with you.</p>",
            "category_id": "contact",
            "category_label": "Contact Information",
            "show_on_home": true
          }
        },
        "faq_item_LQPHGc": {
          "type": "faq_item",
          "settings": {
            "question": "How can I apply for a work opportunity at Banjaaran Studio?",
            "answer": "<p>Please fill out the application form available at the following link (<a href=\"https://forms.gle/WjH8MhVfQ3TbWDf46\" target=\"_blank\">Careers form link</a>) to apply for work opportunities at Banjaaran Studio. We look forward to considering your application.</p>",
            "category_id": "contact",
            "category_label": "Contact Information",
            "show_on_home": true
          }
        }
      },
